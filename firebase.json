{
  "hosting": {
    "public": "website",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "redirects": [
      {
        "source": "/download",
        "destination": "/",
        "type": 301
      },
      {
        "source": "/download/windows",
        "destination": "https://github.com/sanidhyajha220-dev/claude/releases",
        "type": 302
      }
    ],
    "headers": [
      {
        "source": "**/*.@(html|js|webmanifest)",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache" }
        ]
      }
    ]
  }
}
